<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Preferences">

        <!-- Custom preference that will show a dialog/popup -->
        <Preference
            app:key="buttonTracked"
            app:title="Tracked Aplications"
            app:summary="Click to show options" />

        <Preference
            app:key="buttonActivities"
            app:title="Desired Activities"
            app:summary="Click to show options" />

        <Preference
            app:key="buttonNotifications"
            app:title="Manage Notifications"
            app:summary="Click to show options" />

    </PreferenceCategory>

</PreferenceScreen>