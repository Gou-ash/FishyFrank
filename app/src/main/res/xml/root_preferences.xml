<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Personalizacja">

        <Preference
            app:key="buttonTracked"
            app:layout="@layout/preference_redpink"
            app:summary="Click to show options"
            app:title="Tracked Applications" />

        <Preference
            app:key="buttonActivities"
            app:layout="@layout/preference_redpink"
